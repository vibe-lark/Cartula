PUBLIC_URL=http://localhost:3900
DATABASE_PATH=./data/cartula.sqlite
PORT=3900
BASEMAP_STYLE=liberty
# Set an HTTPS raster TILE_URL instead if using another provider.
# Optional outbound proxy: TILE_PROXY_URL=http://proxy:port
MAX_MAPS=1000
# Optional build stamp (commit sha / CI build no.) declared by the service and the App it serves.
# CARTULA_BUILD=9f2c1ab
# Local development only:
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Open-source routing. Empty disables auto-resolve.
OSRM_URL=https://router.project-osrm.org
# OSRM_PROXY_URL=http://proxy:port
